# Local Supabase values: run `npx supabase status -o env` after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only email configuration. Use smtp locally and resend in Vercel.
EMAIL_PROVIDER=smtp
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=55425
EMAIL_FROM=Task Hub <tasks@local.test>
RESEND_API_KEY=

# Server-only cron, delivery-worker, and Auth administration access. Never prefix these with NEXT_PUBLIC_.
CRON_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
